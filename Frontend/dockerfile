# Stage 1: Build Vite app
FROM node:22-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm install

# Define build args
ARG VITE_CLERK_PUBLISHABLE_KEY
ARG VITE_BASE_URL
ARG VITE_CLOUDINARY_URL
ARG VONAGE_API_KEY
ARG VONAGE_API_SECRET

# Set env vars so Vite can access them at build time
ENV VITE_CLERK_PUBLISHABLE_KEY=$VITE_CLERK_PUBLISHABLE_KEY
ENV VITE_BASE_URL=$VITE_BASE_URL
ENV VITE_CLOUDINARY_URL=$VITE_CLOUDINARY_URL
ENV VONAGE_API_KEY=$VONAGE_API_KEY
ENV VONAGE_API_SECRET=$VONAGE_API_SECRET

COPY . .

RUN npm run build

# Stage 2: Serve with NGINX
FROM nginx:1.25-alpine

COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
